  "interactables": [
    { "type": "sign", "id": "sign_entrance", "name": "Cartel", "pos": [380, 1120],
      "text": ["Bosque de Arken.", "Al este: Aldea de Vell. Sigue el camino."] },

    { "type": "npc", "id": "brann", "name": "Brann, el leñador", "look": "woodcutter", "pos": [1520, 1010],
      "dialogue": [
        "¡Buenas! No se ven muchos viajeros por el Bosque de Arken.",
        "El camino hacia el este está despejado; la aldea está justo al salir del bosque.",
        "Aunque... juraría haber escuchado algo detrás de las ruinas del norte."
      ],
      "repeat_dialogue": [
        "Sigue el camino hacia el este y llegarás a la aldea.",
        "Y si te sobra tiempo... echa un vistazo a esas ruinas."
      ],
      "conditional_dialogue": [
        { "requires_secret": "arken_shrine",
          "pages": ["¿Un paso oculto en las ruinas? Llevo veinte años cortando leña aquí y nunca lo vi..."] }
      ]
    },

    { "type": "chest", "id": "chest_potion", "pos": [1240, 1520], "item": "potion", "item_name": "una Poción" },

    { "type": "npc", "id": "mira", "name": "Mira, la viajera", "look": "traveler", "pos": [1800, 1530],
      "dialogue": [
        "Shh... ¿lo oyes? Hay algo que zumba al sureste del bosque.",
        "Yo no tocaría aparatos raros. Pero tú tienes cara de tocarlo todo."
      ],
      "repeat_dialogue": ["Al sureste. Entre la hierba alta. No digas que no te avisé."],
      "conditional_dialogue": [
        { "requires_secret": "arken_shrine",
          "pages": ["Ese zumbido ha parado. ¿Qué has hecho?"] }
      ]
    },

    { "type": "door", "id": "rusty_gate", "name": "Verja oxidada", "style": "gate",
